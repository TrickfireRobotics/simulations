{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cli: build",
            "type": "shell",
            "command": "make build",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "cli: test",
            "type": "shell",
            "command": "make test",
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "cli: lint",
            "type": "shell",
            "command": "make lint",
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "cli: check (fmt + lint + test)",
            "type": "shell",
            "command": "make check",
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "cli: link onto PATH",
            "type": "shell",
            "command": "make link",
            "problemMatcher": ["$rustc"]
        }
    ]
}
