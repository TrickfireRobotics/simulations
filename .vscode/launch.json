{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug sim",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["build", "--bin=sim", "--package=sim"],
                "filter": { "name": "sim", "kind": "bin" }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug sim tests",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["test", "--no-run", "--package=sim"],
                "filter": { "kind": "test" }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ]
}
