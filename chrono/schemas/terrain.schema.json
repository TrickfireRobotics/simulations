{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Terrain patch",
  "type": "object",
  "required": [
    "name",
    "type",
    "size_x",
    "size_y"
  ],
  "additionalProperties": false,
  "properties": {
    "extends": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "rigid_flat",
        "rigid_mesh",
        "scm_flat",
        "scm_heightmap",
        "scm_mesh",
        "mixed"
      ],
      "description": "tier 0-3 of the development plan's terrain fidelity ladder"
    },
    "size_x": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "size_y": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "grid_delta": {
      "type": "number",
      "minimum": 0.002,
      "maximum": 0.5,
      "description": "SCM grid spacing, m"
    },
    "heightmap_file": {
      "type": "string"
    },
    "height_min": {
      "type": "number"
    },
    "height_max": {
      "type": "number"
    },
    "mesh_file": {
      "type": "string"
    },
    "pitch_deg": {
      "type": "number",
      "minimum": -45,
      "maximum": 45
    },
    "roll_deg": {
      "type": "number",
      "minimum": -45,
      "maximum": 45
    },
    "soils": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "soil config names, inlined into the manifest by value"
    },
    "default_soil": {
      "type": "string"
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "x_min",
          "x_max",
          "y_min",
          "y_max",
          "soil"
        ],
        "additionalProperties": false,
        "properties": {
          "x_min": {
            "type": "number"
          },
          "x_max": {
            "type": "number"
          },
          "y_min": {
            "type": "number"
          },
          "y_max": {
            "type": "number"
          },
          "soil": {
            "type": "string"
          }
        }
      }
    },
    "bulldozing": {
      "type": "boolean"
    },
    "bulldozing_params": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "bulldozing_erosion_iters": {
      "type": "integer",
      "minimum": 0
    },
    "active_domains": {
      "type": "boolean"
    },
    "active_domain_margin": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "rigid_friction": {
      "type": "number",
      "minimum": 0,
      "maximum": 3
    },
    "rigid_restitution": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "obstacles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "position"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "box",
              "sphere",
              "cylinder",
              "mesh",
              "convex_hull"
            ]
          },
          "position": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "in the terrain reference frame, m"
          },
          "rotation": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 4
          },
          "dimensions": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "radius": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "length": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "file": {
            "type": "string"
          },
          "margin": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "fixed": {
            "type": "boolean"
          },
          "mass": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "friction": {
            "type": "number",
            "minimum": 0,
            "maximum": 3
          }
        }
      }
    },
    "rock_field": {
      "type": "object",
      "additionalProperties": true,
      "description": "expanded into explicit obstacles by the CLI before the run"
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "file": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        },
        "crs": {
          "type": "string"
        },
        "resolution_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "crop": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "vertical_scale": {
          "type": "number"
        }
      }
    }
  }
}
