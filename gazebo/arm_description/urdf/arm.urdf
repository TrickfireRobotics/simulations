<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="urdf_assembly">
    
    <xacro:property name="mesh_path" value="package://arm_description/meshes" />
    <xacro:arg name="controller_config" default="" />

        
    
    <xacro:arg name="standalone" default="true" />
    <xacro:if value="$(arg standalone)">
    <link name="world" />

    <joint name="world_to_root" type="fixed">
        <parent link="world" />
        <child link="arm_root" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>
    </xacro:if>

