<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="ar_tag_0">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <pose>0 0 0.6 0 0 0</pose>
        <geometry>
          <box>
            <size>0.01 0.09 0.3</size>
          </box>
        </geometry>
      </collision>

      <!-- Backing post/panel, plain white -->
      <visual name="panel">
        <pose>0 0 0.6 0 0 0</pose>
        <geometry>
          <box>
            <size>0.01 0.09 0.3</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.9 0.9 1</ambient>
          <diffuse>0.9 0.9 0.9 1</diffuse>
        </material>
      </visual>

      <!-- Marker face: a thin box (reliable per-face UVs, unlike plane geometry),
           offset just in front of the panel to avoid z-fighting. <pbr> needs SDF
           1.7+ to parse at all, hence the bumped <sdf version> above; the plain
           diffuse/ambient are a fallback in case PBR still doesn't load -->
      <visual name="marker">
        <pose>0.0055 0 0.725 0 0 0</pose>
        <geometry>
          <box>
            <size>0.001 0.05 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://ar_tag_0/materials/textures/tag_0.png</albedo_map>
              <roughness>1.0</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
