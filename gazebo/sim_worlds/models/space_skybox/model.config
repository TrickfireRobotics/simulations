<?xml version="1.0"?>

<model>
  <name>Space skybox</name>
  <version>1.0</version>
  <sdf version="1.7">model.sdf</sdf>

  <author>
    <name>Trickfire Robotics</name>
  </author>

  <description>
    Large unlit, double-sided sphere textured with a starfield, used as a
    backdrop. gz-sim (Harmonic) parses &lt;scene&gt;&lt;sky&gt;&lt;cubemap_uri&gt; but never
    wires it to the renderer (RenderUtil::Update only calls SetSkyEnabled,
    which just toggles Ogre2's default blue atmospheric sky), so a real
    cubemap skybox isn't possible yet - this sphere is the standard
    workaround. See ATTRIBUTION.md for the texture source.
  </description>

</model>
