<?xml version="1.0"?>
<?xml-model href="http://sdformat.org/schemas/root.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<sdf version="1.7">
  <model name="marsyard2022_terrain">
    <pose>0 0 0 0 0 0</pose>
    <static>true</static>

    <link name="marsyard_terrain">

      <collision name="terrain_collision">
        <geometry>
          <heightmap>
            <uri>model://marsyard2022_terrain/dem/marsyard2022_terrain_hm.tif</uri>
            <pos>0 0 0</pos>
            <!-- upstream's raw relief (4.82m over 50m) towers over our ~0.9m-long rover;
                 scaled to a quarter so slopes stay within what a small rover can
                 skid-steer on without tumbling -->
            <size>50 50 1.2052008183915</size>
          </heightmap>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>3.0</mu>
              <mu2>3.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="terrain_visual">
        <geometry>
          <heightmap>
            <use_terrain_paging>false</use_terrain_paging>
            <uri>model://marsyard2022_terrain/dem/marsyard2022_terrain_hm.tif</uri>
            <pos>0 0 0</pos>
            <size>50 50 1.2052008183915</size>
            <texture>
              <diffuse>model://marsyard2022_terrain/dem/marsyard2022_terrain_texture.jpg</diffuse>
              <normal>model://marsyard2022_terrain/dem/flat_normal.png</normal>
              <size>50</size>
            </texture>
          </heightmap>
        </geometry>
      </visual>

    </link>

  </model>
</sdf>
