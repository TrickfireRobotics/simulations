<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rover">
    <!-- Combines the chassis and arm into one robot. The chassis and arm
         models themselves live only in chassis_description/arm_description -
         this file just includes them and adds the joint that mounts the arm
         onto the chassis, plus the single combined ros2_control plugin. standalone=false (set below, before the includes) suppresses the
         world-mount link in arm.urdf and the per-part gz_ros2_control plugins
         in chassis_control.urdf.xacro/arm_control.urdf.xacro, since those
         only make sense when chassis/arm are run as standalone robots. -->
    <xacro:arg name="controller_config" default=""/>
    <xacro:arg name="plugin_extension" default=".so"/>
    <xacro:arg name="standalone" default="false"/>
    <xacro:property name="plugin_extension" value="$(arg plugin_extension)"/>

    <xacro:include filename="$(find chassis_description)/urdf/chassis.urdf"/>
    <xacro:include filename="$(find arm_description)/urdf/arm.urdf"/>

    <!-- PLACEHOLDER MOUNT: the arm's turntable plate actually bolts onto the
         crossbar extrusion (see the "ttb_0094_ttb_0095_2x1_grid_pattern_..."
         link in zips/full_chassis/urdf/full_chassis.urdf, a fuller CAD export
         of the same assembly - chassis_description's "crossbar" link is that
         same part). That export is a different revision with no part names
         in common with chassis_description/urdf/chassis.urdf though, so its
         numbers can't be trusted here - this origin still needs the real
         mount offset/orientation from CAD.

         The -Y offset below is a stopgap, not a CAD number: at xyz="0 0 0" the
         arm's collision geometry overlapped chassismain/crossbar/base_link's
         own collision meshes (a drivetrain bracket), which gz_ros2_control's
         physics then fought every tick, causing the arm to jitter. -Y is
         forward here (front wheels sit at lower Y than the back wheels; see
         chassis_control.urdf.xacro's wheel joint names vs. their link
         positions) - 0.5m forward clears all three overlapping collision
         meshes with margin, verified against their STL bounding boxes. -->
    <joint name="chassis_to_arm_mount" type="fixed">
        <parent link="crossbar"/>
        <child link="arm_base_link"/>
        <origin xyz="0 -0.08 0" rpy="0 0 0"/>
    </joint>

    <gazebo>
        <!-- JOINT CONTROLLER -->
        <plugin filename="libgz_ros2_control-system${plugin_extension}" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <robot_param>robot_description</robot_param>
            <robot_param_node>robot_state_publisher</robot_param_node>
            <parameters>$(arg controller_config)</parameters>
            <update_rate>60</update_rate>
            <!-- gz_ros2_control reads this straight off the plugin element (NOT
                 from the controller YAML's ros__parameters, which this plugin
                 never loads) - it's the proportional gain that turns position
                 error into a velocity command for every position-interface
                 joint on this robot (just the arm here; the chassis wheels
                 command velocity directly). One value for the whole plugin,
                 no per-joint override exists in gz_ros2_control, so this
                 stiffens all four arm joints together, not shoulder_1 alone.
                 gz_ros2_control multiplies the position error by update_rate
                 (60 here) before applying this gain, so effective stiffness
                 is gain * update_rate - at the 0.1 default that's already 6;
                 10.0 (600 effective) was way past stable for this pure-P,
                 no-damping loop and made every joint oscillate. 0.5 matches
                 gz_ros2_control's own official demo config (a 5x bump over
                 default, not 100x) - raise in small steps from here if it
                 still droops, drop back toward 0.1 if it jitters at all. -->
            <position_proportional_gain>0.5</position_proportional_gain>
        </plugin>
    </gazebo>
</robot>
