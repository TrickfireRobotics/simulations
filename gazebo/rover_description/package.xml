<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>rover_description</name>
    <version>0.0.0</version>
    <description>rover (chassis + arm) simulation model, combining chassis_description and arm_description</description>
    <maintainer email="tfrbtcs@uw.edu">Trickfire Robotics</maintainer>
    <license>Apache-2.0</license>

    <exec_depend>chassis_description</exec_depend>
    <exec_depend>arm_description</exec_depend>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <test_depend>ament_lint_auto</test_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
