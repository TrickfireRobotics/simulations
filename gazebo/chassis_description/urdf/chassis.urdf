    <!--
      Wheel ground-contact friction (collision uses a cylinder primitive, not the STL mesh).
      mu=1.0 let the rover skid/slide instead of gripping during skid-steer turns - a bare
      cylinder has much less effective contact-patch grip than a real tire/track, so it
      needs a higher-than-real-world mu to compensate. Raised to 3.0 to match the terrain's
      surface friction (sim_worlds/models/marsyard2022_terrain/model.sdf).
    -->
    <gazebo reference="part_1">
        <mu1>3.0</mu1>
        <mu2>3.0</mu2>
    </gazebo>
