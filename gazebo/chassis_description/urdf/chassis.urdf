        <joint name="wheel_front_left_to_motor" type="continuous">
                <origin xyz="0.0107 0 5.55112e-17" rpy="0 1.5708 -1.03957e-32" />
                <axis xyz="0 0 -1" />
                <parent link="chassis_ak10_9v2_0_5" />
                <child link="chassis_part_2_3" />
        </joint>
        <joint name="wheel_front_right_to_motor" type="continuous">
		<origin xyz="0.0175 1.473039279e-22 -6.428108936e-08" rpy="-2.515978905 -1.570791795 -0.6256137489" />
		<axis xyz="-3.673205103e-06 9.747179571e-12 -1" />
		<parent link="chassis_ak10_9v2_0_2" />
		<child link="chassis_part_2_5" />
        </joint>
        <joint name="wheel_mid_left_to_motor" type="continuous">
                <origin xyz="0.0107 0 5.55112e-17" rpy="0 1.5708 -1.03946e-32" />
                <axis xyz="0 0 -1" />
                <parent link="chassis_ak10_9v2_0_4" />
                <child link="chassis_part_2_1" />
        </joint>
        <joint name="wheel_mid_right_to_motor" type="continuous">
		<origin xyz="0.0175 5.55112e-17 -6.428108931e-08" rpy="-2.515978905 -1.570791795 -0.6256137489" />
		<axis xyz="-3.673205103e-06 9.747179571e-12 -1" />
		<parent link="chassis_ak10_9v2_0_1" />
		<child link="chassis_part_2" />
        </joint>
    <!--
      Wheel ground-contact friction (collision uses a cylinder primitive, not the STL mesh).
      mu=1.0 let the rover skid/slide instead of gripping during skid-steer turns - a bare
      cylinder has much less effective contact-patch grip than a real tire/track, so it
      needs a higher-than-real-world mu to compensate. Raised to 3.0 to match the terrain's
      surface friction (sim_worlds/models/marsyard2022_terrain/model.sdf).
    -->
    <gazebo reference="part_2">
        <mu1>3.0</mu1>
        <mu2>3.0</mu2>
    </gazebo>
    <gazebo reference="part_2_1">
        <mu1>3.0</mu1>
        <mu2>3.0</mu2>
    </gazebo>
    <gazebo reference="part_2_2">
        <mu1>3.0</mu1>
        <mu2>3.0</mu2>
    </gazebo>
    <gazebo reference="part_2_3">
        <mu1>3.0</mu1>
        <mu2>3.0</mu2>
    </gazebo>
    <gazebo reference="part_2_4">
        <mu1>3.0</mu1>
        <mu2>3.0</mu2>
    </gazebo>
    <gazebo reference="part_2_5">
        <mu1>3.0</mu1>
        <mu2>3.0</mu2>
    </gazebo>

    <xacro:include filename="$(find chassis_description)/urdf/chassis_control.urdf.xacro"/>
	<link name="chassis_part_1">
		<inertial>
			<mass value="0.5" />
			<!-- PLACEHOLDER MASS/INERTIA: this is Part_1.stl (the wheel rim/grousers), which
			     Onshape's export had merged as static geometry with no per-part mass computed.
			     Approximated here as a solid cylinder (r=0.097m, h=0.06m matching the mesh's
			     own bounds) at a plausible 0.5kg pending a real material assignment or
			     measured weight. -->
			<origin xyz="0 0 0.03" rpy="0 0 0" />
			<inertia ixx="0.00132613" ixy="0" ixz="0" iyy="0.00132613" iyz="0" izz="0.00235225" />
		</inertial>
		<visual>
			<origin xyz="0 0 0" rpy="0 0 0" />
