	<!--
	  Part_1.stl (the real wheel rim/grousers) was statically merged into base_link by
	  Onshape's exporter even though it is rigidly bolted to part_2 (the hub that actually
	  spins with the motor) - so the visible wheel never rotated. Re-parented here as a
	  fixed child of part_2 so it rotates together with its hub.
	-->
	<joint name="part_2_to_rim" type="fixed">
		<origin xyz="-1.891070633e-11 -7.349149067e-12 0" rpy="7.252849981e-10 2.853505366e-10 -2.061444063e-10" />
		<axis xyz="0 0 1" />
