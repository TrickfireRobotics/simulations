<?xml version="1.0" ?>
<sdf version="1.6">
    <!-- SDF FILE DOCUMENTATION: https://gazebosim.org/docs/fortress/sdf_worlds/ -->
    <world name="drone_world">

        <!-- CORE PLUGINS -->
        <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
        </plugin>
        <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
        </plugin>
        <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
        </plugin>
        <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact">
        </plugin>
        <!-- gz-sim-sensors-system only drives rendering-based sensors
             (cameras etc.) - the actual IMU data the ArduPilotPlugin waits
             on comes from the separate, non-rendering gz-sim-imu-system. -->
        <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>
        <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
        </plugin>
        <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat">
        </plugin>

        <!-- PHYSICS -->
        <physics name="4ms" type="ignored">
            <max_step_size>0.004</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>

        <!-- The Sensors system's offscreen render engine needs this to
             configure its own scene - without it the render thread hangs
             waiting for initialization that never happens. -->
        <scene>
            <ambient>0.4 0.4 0.4</ambient>
            <background>0.7 0.7 0.7</background>
            <shadows>true</shadows>
            <grid>false</grid>
        </scene>

        <!-- LIGHTS -->
        <light type="directional" name="sun">
            <cast_shadows>false</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <!-- GROUND -->
        <model name="ground_plane">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                    <material>
                        <ambient>0.8 0.8 0.8 1</ambient>
                        <diffuse>0.8 0.8 0.8 1</diffuse>
                        <specular>0.8 0.8 0.8 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!--
          Quadcopter model + ArduPilotPlugin, from ardupilot_gazebo
          (https://github.com/ArduPilot/ardupilot_gazebo). Resolved via
          GZ_SIM_RESOURCE_PATH, which `sim gazebo drone` points at the
          models/ directory built by `sim gazebo setup-drone`.
        -->
        <include>
            <uri>model://iris_with_ardupilot</uri>
            <name>drone</name>
            <pose>0 0 0.2 0 0 0</pose>
        </include>

    </world>
</sdf>
